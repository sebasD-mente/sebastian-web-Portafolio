.venv
venv
__pycache__
.agents/.runtime
*.local.md
*.log
*.tmp
*.bak
*.swp
*~
.DS_Store
Thumbs.db

# Documentación, memoria y suites de prueba no requeridas en el contexto de imagen runtime
docs
memory
tests
