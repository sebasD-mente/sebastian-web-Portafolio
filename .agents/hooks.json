{
  "harness-safety-gate": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ../scripts/harness-hooks.mjs pre-invocation --agy",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ../scripts/harness-hooks.mjs pre-tool-use --agy",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "run_command|bash|execute_command|shell|Bash|write_file|edit_file|write|edit|multiedit|Write|Edit|MultiEdit|NotebookEdit|create_file|replace_file_content|multi_replace_file_content|write_to_file|str_replace_editor|str_replace_based_edit_tool|edit_notebook|apply_patch|send_message|sendmessage|SendMessage|call_mcp_tool|mcp_.*|.*(?:write|edit|replace|create|patch|save|move|copy|rename).*",
        "hooks": [
          {
            "type": "command",
            "command": "node ../scripts/harness-hooks.mjs post-tool-use --agy",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ../scripts/harness-hooks.mjs stop --agy",
        "timeout": 60
      }
    ]
  }
}
