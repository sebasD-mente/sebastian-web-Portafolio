{
  "harness-safety-gate": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "write_file|edit_file|Write|Edit|MultiEdit|create_file|replace_file_content|multi_replace_file_content|run_command|Bash|send_message|call_mcp_tool|mcp_.*",
        "hooks": [
          {
            "type": "command",
            "command": "node ../scripts/harness-hooks.mjs pre-tool-use",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file|Write|Edit|MultiEdit|create_file|replace_file_content|multi_replace_file_content|call_mcp_tool|mcp_.*",
        "hooks": [
          {
            "type": "command",
            "command": "node ../scripts/harness-hooks.mjs post-tool-use",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ../scripts/harness-hooks.mjs stop",
        "timeout": 60
      }
    ]
  }
}
