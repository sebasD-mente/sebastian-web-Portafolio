# ==============================================================================
# Plantilla de Variables de Entorno — dekolabs.org (Ubuntu Linux Home Lab)
# Copia este archivo a '.env' en el servidor antes de ejecutar docker compose:
#   cp .env.example .env
# Prohibido versionar el archivo '.env' real en Git (protegido por .gitignore).
# ==============================================================================

# Configuración del servidor Next.js 15 Standalone
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
NEXT_TELEMETRY_DISABLED=1

# Identidad y telemetría del nodo en el Ubuntu Linux Home Lab
HOMELAB_NODE_ID="HOME-LAB: UBUNTU-NODE-01"
HOMELAB_PUBLIC_DOMAIN="dekolabs.org"
HOMELAB_CANONICAL_URL="https://dekolabs.org"
HOMELAB_DEPLOYED_REVISION="v2.1-atelier-monolith"

# Persistencia PostgreSQL 17 + pgvector (Catálogo Administrable y Base RAG)
POSTGRES_USER="dekolabs"
POSTGRES_PASSWORD="change_this_postgres_password_in_production"
POSTGRES_DB="dekolabs_portfolio"
DATABASE_URL="postgresql://dekolabs:change_this_postgres_password_in_production@dekolabs-db:5432/dekolabs_portfolio"

# Administración del Catálogo (/admin/proyectos) y Volumen de Imágenes (read_only-safe)
ADMIN_ACCESS_KEY="change_this_admin_access_key_in_production"
CATALOG_UPLOADS_DIR="/app/data/uploads"
