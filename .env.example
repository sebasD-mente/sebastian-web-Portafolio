# ==============================================================================
# Plantilla de Variables de Entorno — dekolabs.org (Ubuntu Linux Home Lab)
# Copia este archivo a '.env' en el servidor antes de ejecutar docker compose:
#   cp .env.example .env
# Prohibido versionar el archivo '.env' real en Git (protegido por .gitignore).
# ==============================================================================

# Configuración del servidor Next.js 15 Standalone
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
NEXT_TELEMETRY_DISABLED=1

# Identidad y telemetría del nodo en el Ubuntu Linux Home Lab
HOMELAB_NODE_ID="HOME-LAB: UBUNTU-NODE-01"
HOMELAB_PUBLIC_DOMAIN="dekolabs.org"
HOMELAB_CANONICAL_URL="https://dekolabs.org"
HOMELAB_DEPLOYED_REVISION="v2.1-atelier-monolith"
